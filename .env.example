# Public URL of the site (used for OAuth callbacks, sitemap and share images)
NEXT_PUBLIC_SITE_URL=https://www.opulencebyte.com

# Sign-in sessions: any long random string (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Razorpay (quote fee in USD needs International Payments enabled, donations use INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Byte AI chat (Claude). Without a key the chat answers from built-in product info.
ANTHROPIC_API_KEY=

# Lead emails for contact form and paid quotes (https://resend.com). Without a key leads are logged.
RESEND_API_KEY=
LEADS_INBOX=hello@opulencebyte.com
LEADS_FROM=Opulence Byte <onboarding@resend.dev>
# Sender of the payment confirmation email to customers (the domain must be verified in Resend)
CUSTOMER_MAIL_FROM=Opulence Byte <contact@opulencebyte.com>
